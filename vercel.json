{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/service/(.*)",
      "destination": "/service/index.html"
    },
    {
      "source": "/service",
      "destination": "/service/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
